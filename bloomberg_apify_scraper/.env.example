# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# - realtime: Continuously polls Bloomberg sitemap for new articles
# - single: Scrapes a single article URL and exits
SCRAPE_MODE=realtime

# Real-Time Mode Settings
# Maximum number of URLs to scrape on the first iteration
# Helps control costs when starting up
MAX_INITIAL_URLS=25

# How often to check the sitemap for new articles (in seconds)
# Default: 300 (5 minutes)
POLL_INTERVAL_SECONDS=300

# Number of URLs to process per Apify actor run
# Lower values = more actor runs but better error isolation
# Higher values = fewer runs but more efficient
BATCH_SIZE=5

# Single Article Mode Settings
# URL of the single article to scrape (used when SCRAPE_MODE=single)
# Can also be provided via --url command line argument
SINGLE_ARTICLE_URL=

# Persistence (Optional)
# Path to JSON file for persisting scraped URLs between sessions
# Leave empty to disable persistence (URLs tracked in memory only)
PERSISTENCE_FILE=scraped_urls.json

LOG_LEVEL=INFO
